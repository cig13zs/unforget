{
  "manifest_version": 3,
  "name": "Unforget: Search Every Page You've Read",
  "short_name": "Unforget",
  "version": "1.0.0",
  "description": "Find that article you read last week by what it said, not its title. Full-text search of your browsing, 100% local.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "action": {
    "default_title": "Unforget: search pages you've read",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "uf"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "activeTab", "sidePanel", "contextMenus"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open Unforget search"
    },
    "open-ask": {
      "description": "Ask your history"
    }
  }
}
