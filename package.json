{
  "name": "unforget",
  "version": "1.0.0",
  "private": true,
  "description": "Find that article you read last week by what it said, not its title. Full-text search of your browsing, 100% local.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/build.mjs",
    "build:mcp": "npm run build -w unforget-mcp",
    "typecheck": "tsc --noEmit && tsc -p mcp/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "zip": "npm run build && node scripts/zip.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/literata": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@mozilla/readability": "^0.6.0",
    "idb": "^8.0.2",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.5",
    "eslint": "^9.26.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
